<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget (Azul, modo oscuro): cristal translúcido azul claro. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#EB23365C"
        android:endColor="#DF172540" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1.5dp"
        android:color="#FF3D5A94" />
</shape>
