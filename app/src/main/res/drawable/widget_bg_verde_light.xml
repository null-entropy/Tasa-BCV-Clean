<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget (Verde, modo claro): cristal translúcido verdoso intenso. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#EBE8F7EF"
        android:endColor="#DFCCEAD9" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1.5dp"
        android:color="#FF7EB89C" />
</shape>
