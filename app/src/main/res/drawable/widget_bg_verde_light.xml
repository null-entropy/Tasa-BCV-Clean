<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget (Verde, modo claro): cristal translúcido verdoso intenso. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#C8DFF2E8"
        android:endColor="#B8CFE8DA" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#809FC2AE" />
</shape>
