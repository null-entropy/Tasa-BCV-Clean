<?xml version="1.0" encoding="utf-8"?>
<!-- Icono legacy para API 24-25 (pre-adaptive). Combina fondo + símbolo "$"
     en un solo vector. En API 26+ se usa mipmap-anydpi-v26/ic_launcher en su lugar.
     Diseño minimalista: mismo concepto que el adaptive icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

      <!-- Fondo: degradado grafito negro -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF1C1D21" />
                <item android:offset="0.5" android:color="#FF101114" />
                <item android:offset="1" android:color="#FF060708" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Curva "S" del símbolo dólar -->
    <path
        android:pathData="M44.5,46.5
            C44.5,41.5  51,38  54,38
            C57,38  63.5,39  63.5,45
            C63.5,51  55,52.5  54,53
            C53,53.5  44.5,55  44.5,61
            C44.5,67  51,70  54,70
            C57,70  63.5,69  63.5,64.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Barra vertical del "$" -->
    <path
        android:pathData="M54,34 L54,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

</vector>
