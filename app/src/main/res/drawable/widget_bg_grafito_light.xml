<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget (Sistema/grafito, modo claro): cristal translúcido. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#C8FCFDFE"
        android:endColor="#B8F1F2F5" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#80C7CAD3" />
</shape>
